{
  "experiment_id": "EXP-CYCLIC-STEPWISE-01",
  "run_mode": "SMOKE_TEST_ONLY",
  "timestamp_iso": "2026-10-16T13:00:01Z",
  "objective": "Determine whether auxiliary supervision of the intermediate destination-register values (steps 0 and 1) improves modular-addition generalization in the existing CyclicMGUPhase16Model and the learned representations supplied to the fixed cyclic ALU.",
  "hypothesis": "HYPOTHESIS (not a proven cause): terminal-only supervision may allow the learned read/write/gate pathways to fit the final answer without learning intermediate representations compatible with the ALU's canonical harmonic coordinate system. This experiment tests whether intermediate destination-value supervision helps.",
  "scientific_distinction": "The cyclic ALU is fixed and analytical. Any improvement from this intervention concerns the supervision of the learned read, write and gate networks around it; it is not evidence of learned arithmetic from data.",
  "loss_definition": {
    "terminal_loss": "CE(out.logits, y_terminal)",
    "auxiliary_loss": "mean(CE(out.step_logits[:, 0, :], y_destination_0), CE(out.step_logits[:, 1, :], y_destination_1))",
    "total_loss": "terminal_loss + 1.0 * auxiliary_loss",
    "auxiliary_coefficient": 1.0,
    "step_2_auxiliary_supervision": "excluded (out.logits == out.step_logits[:, -1, :])"
  },
  "target_definition": {
    "canonical_trace": [
      "SET r0 a",
      "SET r1 b",
      "ADD r0 r1"
    ],
    "destination_target_sequence": "(a, b, (a + b) % 10)",
    "extraction": "step_targets[b, t, argmax(inputs[b, t, 4:8])]",
    "verification": "matched Phase16RegisterTask.simulate_trace() on every allowed example"
  },
  "metric_definitions": {
    "c_read": "mean of the per-role mean cosine(u_a, Phi(a)) and cosine(u_b, Phi(b)) at step 2",
    "c_read_r0": "mean cosine(u_a, Phi(a)) at step 2",
    "c_read_r1": "mean cosine(u_b, Phi(b)) at step 2",
    "s_context": "unweighted mean over digits of the mean pairwise cosine similarity of same-integer step-2 operand reads pooled across role and context",
    "c_alu": "mean cosine of the raw cyclic_alu(u_a, u_b) tensor at step 2 with Phi((a+b)%10)",
    "c_dest": "mean of the step-0/1/2 mean cosines of u_dest_post with Phi(y_destination_t)",
    "cosine_guard": "denominator epsilon 1e-08; similarity 0.0 if either norm < 1e-07"
  },
