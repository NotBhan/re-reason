{
  "experiment_id": "EXP-CYCLIC-PERSIST-01",
  "run_mode": "SMOKE_TEST_ONLY",
  "timestamp_iso": "2026-10-16T15:57:42Z",
  "objective": "Determine whether auxiliary supervision of unaddressed-register persistence at the step-1 transition (requiring r0 to preserve operand a during S1 -> S2) eliminates the r0/r1 read asymmetry and restores canonical ALU input alignment in CyclicMGUPhase16Model.",
  "hypothesis": "HYPOTHESIS (not a proven cause): insufficient persistence supervision at step 1 may be the primary cause of the r0/r1 read asymmetry, because r0 receives zero direct gradient signal during the S1 -> S2 transition. This experiment tests whether intermediate persistence supervision helps.",
  "scientific_distinction": "The cyclic ALU is fixed and analytical. Any improvement from this intervention concerns the supervision of the learned read, write and gate networks around it; it is not evidence of learned arithmetic from data.",
  "loss_definition": {
    "total_loss": "terminal_loss + 1.0 * destination_loss + 0.5 * persistence_loss",
    "terminal_loss": "CE(logits_terminal, (a + b) % 10)",
    "destination_loss": "0.5 * [CE(logits_dest_0, a) + CE(logits_dest_1, b)]",
    "persistence_loss": "CE(logits_persist_1, a)",
    "lambda_dest": 1.0,
    "lambda_persist": 0.5,
    "step_2_auxiliary_supervision": "excluded (logits_terminal == step_logits[:, -1, :])",
    "effective_per_assertion_weight": 0.5
  },
  "persistence_query_definition": {
    "state": "S2 (post step-1 transition, instruction 'SET r1 b')",
    "register": "r0 (unaddressed at step 1, written at step 0)",
    "address": "e_r0 = [1, 0, 0, 0]",
    "readout": "project(mlp_read([S2, e_r0])) using the existing shared mlp_read network",
    "decode": "prototype bank u_persist @ Phi^T (fixed 5-harmonic basis)",
    "target": "a (the r0 value written at step 0)",
    "equivalence": "u_persist_1 is computationally identical to the step-2 operand read u_a"
  },
  "target_definition": {
    "canonical_trace": [
      "SET r0 a",
      "SET r1 b",
      "ADD r0 r1"
    ],
    "destination_target_sequence": "(a, b, (a + b) % 10)",
    "persistence_target": "a",
    "extraction": "step_targets[b, t, argmax(inputs[b, t, 4:8])]",
    "verification": "matched Phase16RegisterTask.simulate_trace() on every allowed example"
  },
  "metric_definitions": {
    "c_read": "mean of the per-role mean cosine(u_a, Phi(a)) and cosine(u_b, Phi(b)) at step 2",
    "c_read_r0": "mean cosine(u_a, Phi(a)) at step 2",
    "c_read_r1": "mean cosine(u_b, Phi(b)) at step 2",
    "c_persist_r0": "mean cosine(u_persist_1, Phi(a)) at step 1",
    "s_context": "unweighted mean over digits of the mean pairwise cosine similarity of same-integer step-2 operand reads pooled across roles and contexts",
    "c_alu": "mean cosine of the raw cyclic_alu(u_a, u_b) tensor at step 2 with Phi((a+b)%10)",
    "c_dest": "mean of the step-0/1/2 mean cosines of u_dest_post with Phi(y_destination_t)",
    "cosine_guard": "denominator epsilon 1e-08; similarity 0.0 if either norm < 1e-07"
  },
